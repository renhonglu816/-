PORT=3001
NODE_ENV=development

# 数据库与认证
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
ALLOW_MOCK_AUTH=false

# 阿里云百炼 Qwen API（密钥只允许配置在后端）
DASHSCOPE_API_KEY=replace-with-your-api-key
# 从百炼工作空间的“OpenAI 兼容”调用页面复制 base_url；北京地域格式如下：
DASHSCOPE_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.8-omni-flash
# 药盒识别优先低延迟；可改为 low、medium 或 xhigh
DASHSCOPE_REASONING_EFFORT=none
AI_REQUIRE_AUTH=true

# 生产环境请填写实际前端来源，多个来源用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# 可选：启用提醒队列时配置 Redis
ENABLE_TASK_QUEUE=false
REDIS_HOST=localhost
REDIS_PORT=6379
